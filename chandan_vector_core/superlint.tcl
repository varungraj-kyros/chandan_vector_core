##clear all######
clear -all
##################################################################################################################
#setup the rule
 config_rtlds -rule -enable -domain {LINT}
 config_rtlds -rule -disable -domain {AUTO_FORMAL}
 config_rtlds -rule -disable -category {NAMING FILEFORMAT}

#check_superlint -configure -load_rule_file <file_name> if there or no required
################################TO save the rule file################################################
#check_superlint -configure -save_rule_file lint_rules.def
################################To load later rule file################################################
#check_superlint -configure -load_rule_file lint_rules.def

#####################################################################################################################

################################ Load RTL ################################
analyze -verilog -f all_modules.f

################################ Elaborate ################################
elaborate 
#########################################For the gobal signal##################################################
clock clk
reset reset
###############################################To run LINT ################################################
check_superlint -extract

#check_superlint -waiver -add -tag VERI-9033 -comment "Instruction memory array intentionally black-boxed"
##################################################To save the wavier##########################
check_superlint -waiver -add -tag OTP_NR_ASYA -comment "These modules implement purely combinational ALU datapath logic.Outputs are driven directly by combinational logic without clocked storage.Registering is performed at the enclosing pipeline stage.This behavior is intentional and architecturally required."

######################################################
check_superlint -waiver -add -tag IDX_NR_DTTY -comment "The index signals (write_address*, vector_write_address, reserve_vd, release_vd) are generated by fully decoded control logic and are never driven to X or Z. Although declared as reg/wire, they behave as 2-state indices in all legal scenarios."

#check_superlint -waiver -add -tag FLP_NR_ENCT -comment "Instruction memory write enable is used only during program load. During normal operation it is intentionally constant."

####################################################
#check_superlint -waiver -add -tag REG_NR_RWRC -comment "Instruction memory supports program loading and instruction fetch in separate phases. Read and write enables are mutually exclusive by design"
###########################################

check_superlint -waiver -add -tag MOD_IS_SYAS -comment "This module is architected to include synchronous state elements (register/memory write, state update) along with asynchronous combinational logic (read paths, decode, control, compare).This separation is by design and required for correct functionality."


#########
check_superlint -waiver -add -tag NET_NO_LDDR -comment "These nets are part of a parameterized/expandable memory and register-file structure.In the current configuration they are not driven or loaded, but are retained for completeness and future feature enablement. This does not impact functionality."

#check_superlint -waiver -add -tag INP_NO_USED -comment "These ports are part of the architectural interface of the write_back module and are reserved for future features and configuration variants.In the current implementation they are not required and therefore unused."

#check_superlint -waiver -add -tag INS_NR_INPR -comment "Inputs are driven by combinational pipeline signals. Pipeline registers already provide timing isolation; registering these inputs would add incorrect latency and break forwarding and hazard logic."

check_superlint -waiver -add -tag ARY_MS_DRNG -comment "The design uses both ascending and descending ranges to match external interfaces and legacy memory/register definitions. This does not affect functional correctness or synthesis results."

check_superlint -waiver -add -tag ASG_NR_POVF -comment "This block implements fixed-width arithmetic  (multiply/divide) and pc.Intermediate results may exceed the destination width and are intentionally truncated to the defined output width as per the architecture."

check_superlint -waiver -add -tag OTP_NR_READ -comment " The output signals (remainder_signed/unsigned, wb_vec_data) are reused inside the module for datapath/control purposes.This is a valid modeling style and does not create multiple drivers or functional ambiguity ."

#check_superlint -waiver -add -tag REG_NR_UASR -comment "Memory arrays are accessed via read/write semantics and may be externally initialized (ROM/SRAM). They are not standard RTL registers, so procedural assignment is not required."


#check_superlint -waiver -add -tag FLP_NO_ASRT -comment "Register file flip-flops intentionally omit asynchronous reset. Register contents are architecturally undefined after reset and initialized by software. This reduces area and reset fanout."


check_superlint -waiver -add -tag INS_NR_INPR -comment "These instances belong to a pipelined datapath where inputs are registered at the pipeline stage boundary (EX/MEM/WB).Sub-modules operate on already-registered signals and do not require additional input registers."

check_superlint -waiver -add -tag MOD_NS_GLGC -comment "Top-level module intentionally contains small combinational glue logic for interconnecting pipeline blocks. This is integration logic and is functionally correct."

check_superlint -waiver -add -tag CMB_NR_TLIO -comment "The path from top-level input in_1 to top-level output alu_out is intentionally combinational as part of the ALU datapath. No sequential element is required in this block."

check_superlint -waiver -add -tag CAS_NR_DEFX -comment "alu_out is assigned a deterministic value (0) in the default case to avoid X-propagation. This behavior is intentional and required for stable ALU operation."
           
check_superlint -waiver -add -tag MOD_NO_IPRG -comment "This module implements a purely combinational ALU datapath.Input signals (in_1, in_2, alu_op, sew, cin) are registered in the upstream pipeline stage."

check_superlint -waiver -add -tag LOP_NR_RPVR -comment "The remainder signal is intentionally referenced multiple times within the loop body
to compute successive partial remainders."

check_superlint -waiver -add -tag FLP_NR_MXCS -comment "The logic computes the next-state/enable condition for the flop 'active' within the clocked always block. This is a standard and safe coding style and does not infer unintended logic."

check_superlint -waiver -add -tag RST_XC_LDTH -comment "the reset signal is intentionally used in limited combinational logic to control initialization of vector register file write enables."

#check_superlint -waiver -add -tag WIR_NO_READ -comment "curr_addr_w is retained for debug/visibility and future address-related enhancements in the vector LSU. In the current implementation it is not required to drive any logic."

#check_superlint -waiver -add -tag NET_NO_LOAD -comment "curr_addr_w is retained for debug/observability and future LSU address-related enhancements. In the current configuration it does not drive downstream logic."

##check_superlint -waiver -add -tag INP_NO_USED -comment "Unused bits of in_2 are intentionally declared to maintain, uniform interface across sra_16_logic, sra_32_logic, and sra_64_logic. Higher bits are not required for this configuration."
redirect -file superlint_report1.txt {   check_superlint -report }

